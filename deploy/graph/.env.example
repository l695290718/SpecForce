# Copy to deploy/graph/.env for the optional local NebulaGraph compatibility profile.
# These images are supplied by the graph gateway/projector runtime delivery.
SPECFORGE_GRAPH_GATEWAY_IMAGE=specforge/graph-gateway:latest
SPECFORGE_GRAPH_PROJECTOR_IMAGE=specforge/graph-projector:latest
SPECFORGE_NEBULA_USER=root
SPECFORGE_NEBULA_PASSWORD=replace-with-a-local-compatibility-password
SPECFORGE_NEBULA_SPACE=specforge_graph

# External NebulaGraph cluster mode: do not include deploy/compose.graph-local.yaml.
# Deploy Gateway and Projector with your platform orchestrator and set the cluster endpoint there.
# SPECFORGE_NEBULA_ADDRESS=nebula-graphd.internal.example.com:9669
# SPECFORGE_NEBULA_USER=specforge_gateway
# SPECFORGE_NEBULA_PASSWORD=store-in-your-secret-manager
# SPECFORGE_NEBULA_SPACE=specforge_graph
