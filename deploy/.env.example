# Copy this file to deploy/.env on the deployment host. Do not commit deploy/.env.
POSTGRES_USER=specforge
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=specforge
SPECFORGE_WEB_PORT=3010
SPECFORGE_BOOTSTRAP_VERSION=2026-08-12.v1
# Set to 1 only after verifying this is an existing SpecForge database; adoption repairs relationships without reseeding authored assets.
SPECFORGE_BOOTSTRAP_ADOPT_EXISTING=0
SPECFORGE_PROJECTOR_HEALTH_APPLICATION_SERVICE_ID=com.huawei.celon.desiner
SPECFORGE_PROJECTOR_HEALTH_SCOPE_PATH=pf-huawei/product-celon/subproduct-platform/module-celon-designer/com.huawei.celon.desiner
SPECFORGE_3A_CURSOR_ACTIVE_KEY_ID=local-development
# Generate a deployment-only secret, then base64 encode it. Do not reuse this example value in production.
SPECFORGE_3A_CURSOR_KEYS='{"local-development":"c3BlY2ZvcmdlLWxvY2FsLWRlcGxveW1lbnQtY3Vyc29yLWtleQ=="}'
SPECFORGE_WEB_AUTH_MODE=static
# Server-side Web principal. Replace the actor identity, tenant, and credential grants per deployment.
SPECFORGE_WEB_PRINCIPAL_CLAIMS='{"actorType":"agent","actorId":"specforge-web-agent","tenantId":"local-development","authSource":"static-bearer","grants":[{"scopeId":"com.huawei.celon.desiner","action":"read"}],"permissions":["knowledge:read"]}'
SPECFORGE_ENTERPRISE_ID=legacy-enterprise
SPECFORGE_3A_BOOTSTRAP_POLL_INTERVAL_MS=1000
SPECFORGE_3A_BOOTSTRAP_TIMEOUT_MS=300000
SPECFORGE_KNOWLEDGE_PROJECTOR_LEASE_MS=300000
SPECFORGE_CONNECTOR_WORKER_APPLICATION_SERVICE_ID=com.huawei.celon.desiner
SPECFORGE_CONNECTOR_WORKER_SCOPE_PATH=pf-huawei/product-celon/subproduct-platform/module-celon-designer/com.huawei.celon.desiner
SPECFORGE_CONNECTOR_WORKER_INTERVAL_MS=5000
SPECFORGE_CONNECTOR_WORKER_BATCH_LIMIT=10

# External PostgreSQL mode only. Leave DATABASE_URL unset for bundled PostgreSQL.
# DATABASE_URL=postgresql://user:password@database.example.com:5432/specforge?schema=public
# SPECFORGE_EXTERNAL_PG_HOST=database.example.com
# SPECFORGE_EXTERNAL_PG_PORT=5432
