generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model DesignAsset {
  dbId        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id          String
  type        String
  name        String
  code        String?
  description String
  domainId    String?
  applicationServiceId String
  scopePath   String
  payload     String
  integrationCallKey       String?
  integrationSortKey       String?
  integrationTargetBinding String?
  integrationProtocolKind  String?
  integrationProtocolLocator String?
  integrationResolutionStatus String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
  @@index([domainId])
  @@index([applicationServiceId])
  @@index([scopePath])
  @@index([applicationServiceId, scopePath, type, integrationSortKey])
  @@unique([applicationServiceId, scopePath, id])
  @@unique([applicationServiceId, scopePath, integrationCallKey])
}

model Proposal {
  dbId        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id          String
  title       String
  description String
  status      String
  domainId    String?
  applicationServiceId String
  scopePath   String
  payload     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([applicationServiceId])
  @@index([scopePath])
  @@unique([applicationServiceId, scopePath, id])
}

model ContextPack {
  dbId              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id                String
  name              String
  proposalId        String
  targetAgent       String
  summary           String
  includedAssets    String
  constraints       String
  instructions      String
  generatedMarkdown String
  payload           String?
  applicationServiceId String
  scopePath           String
  createdAt         DateTime @default(now())

  @@index([proposalId])
  @@index([applicationServiceId])
  @@index([scopePath])
  @@unique([applicationServiceId, scopePath, id])
}

model AssetSearchProjection {
  dbId                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationServiceId String
  scopePath            String
  assetType            String
  assetId              String
  canonicalName        String
  canonicalSummary     String
  localizedNameZh      String
  localizedSummaryZh   String
  domainId             String?
  status               String?
  updatedAt            DateTime
  catalogVersion       BigInt
  contentDigest        String
  searchDocument       String
  createdAt            DateTime @default(now())

  @@unique([applicationServiceId, scopePath, assetType, assetId], map: "AssetSearchProjection_scope_asset_key")
  @@index([applicationServiceId, scopePath, assetType, updatedAt, assetId], map: "AssetSearchProjection_scope_type_updated_idx")
  @@index([applicationServiceId, scopePath, domainId, assetType, updatedAt, assetId], map: "AssetSearchProjection_scope_domain_type_updated_idx")
}

model AuthoredCatalogCursor {
  dbId                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationServiceId String
  scopePath            String
  nextVersion          BigInt   @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  revisions AuthoredAssetRevision[]

  @@unique([applicationServiceId, scopePath])
  @@index([applicationServiceId, scopePath, nextVersion])
}

model AuthoredAssetRevision {
  dbId                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationServiceId String
  scopePath            String
  catalogVersion       BigInt
  assetType            String
  assetId              String
  operation            String
  payload              Json     @db.JsonB
  contentDigest        String
  actorType            String
  actorId              String
  channel              String
  correlationId        String
  idempotencyKey       String
  createdAt            DateTime @default(now())

  cursor AuthoredCatalogCursor @relation(fields: [applicationServiceId, scopePath], references: [applicationServiceId, scopePath])

  @@unique([applicationServiceId, scopePath, idempotencyKey])
  @@index([applicationServiceId, scopePath, catalogVersion])
  @@index([applicationServiceId, scopePath, assetType, assetId, catalogVersion])
}

model GovernanceCheckSnapshot {
  id                   String   @id @default(cuid())
  assetType            String
  assetId              String
  results              String
  applicationServiceId String?
  scopePath            String?
  createdAt            DateTime @default(now())

  @@index([assetType, assetId])
  @@index([applicationServiceId, scopePath, assetType, assetId])
}

model AssetLink {
  dbId         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id           String
  sourceType   String
  sourceId     String
  targetType   String
  targetId     String
  relationType String
  description  String?
  applicationServiceId String
  scopePath   String
  createdAt    DateTime @default(now())

  @@index([sourceType, sourceId])
  @@index([targetType, targetId])
  @@index([relationType])
  @@index([applicationServiceId])
  @@index([scopePath])
  @@unique([applicationServiceId, scopePath, id])
}

model ArchitectureScope {
  id          String   @id
  code        String   @unique
  name        String
  description String
  owner       String
  level       String
  parentId    String?
  scopePath   String   @unique
  purpose     String   @default("product")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  scopeOperationGrants      ScopeOperationGrant[]
  credentialOperationGrants AgentCredentialScopeGrant[]

  @@index([parentId])
  @@index([level])
}

model DeploymentBootstrap {
  bootstrapKey String   @id
  status       String
  version      String
  attemptCount Int      @default(0)
  counts       String   @default("{}")
  errorMessage String?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
}

model ActorScopeGrant {
  id        String   @id @default(cuid())
  actorType String
  actorId   String
  scopeId   String
  action    String
  createdAt DateTime @default(now())

  @@unique([actorType, actorId, scopeId, action])
  @@index([actorType, actorId])
}

model UserAccount {
  id                   String   @id @default(cuid())
  login                String   @unique
  displayName          String
  passwordDigest       String
  status               String   @default("ACTIVE")
  isAdministrator      Boolean  @default(false)
  authorizationVersion BigInt   @default(1)
  credentialVersion    BigInt   @default(1)
  disabledAt           DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  agents AgentIdentity[]
  grants ScopeOperationGrant[] @relation("ScopeGrantSubject")
  sessions WebSession[]

  @@index([status, login])
}

model AgentIdentity {
  id          String   @id @default(cuid())
  ownerUserId String
  name        String
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner       UserAccount       @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  credentials AgentCredential[]

  @@unique([ownerUserId, name])
  @@index([ownerUserId, status])
}

model AgentCredential {
  id           String   @id @default(cuid())
  agentId      String
  secretDigest String   @unique
  status       String   @default("ACTIVE")
  version      Int      @default(1)
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  agent       AgentIdentity              @relation(fields: [agentId], references: [id], onDelete: Restrict)
  grantCeiling AgentCredentialScopeGrant[]

  @@index([secretDigest, status, expiresAt])
  @@index([agentId, status, expiresAt])
}

model ScopeOperationGrant {
  id                   String   @id @default(cuid())
  subjectId            String
  applicationServiceId String
  operation            String
  createdByUserId      String?
  createdAt            DateTime @default(now())

  subject              UserAccount       @relation("ScopeGrantSubject", fields: [subjectId], references: [id], onDelete: Restrict)
  scope                ArchitectureScope @relation(fields: [applicationServiceId], references: [id], onDelete: Restrict)

  @@unique([subjectId, applicationServiceId, operation])
  @@index([subjectId, applicationServiceId, operation])
  @@index([applicationServiceId, operation])
}

model AgentCredentialScopeGrant {
  id                   String   @id @default(cuid())
  credentialId         String
  applicationServiceId String
  operation            String
  createdAt            DateTime @default(now())

  credential           AgentCredential   @relation(fields: [credentialId], references: [id], onDelete: Restrict)
  scope                ArchitectureScope @relation(fields: [applicationServiceId], references: [id], onDelete: Restrict)

  @@unique([credentialId, applicationServiceId, operation])
  @@index([credentialId, applicationServiceId, operation])
}

model WebSession {
  id           String   @id @default(cuid())
  userId       String
  secretDigest String   @unique
  csrfDigest   String
  status       String   @default("ACTIVE")
  idleExpiresAt DateTime
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user UserAccount @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, status, expiresAt])
  @@index([status, idleExpiresAt, expiresAt])
}

model SecurityAudit {
  id           String   @id @default(cuid())
  actorType    String
  actorId      String
  action       String
  targetType   String
  targetId     String
  outcome      String
  reason       String?
  correlationId String?
  metadata     Json     @default("{}") @db.JsonB
  createdAt    DateTime @default(now())

  @@index([actorType, actorId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([createdAt])
}

model LegacyScopeGrantMigrationReport {
  id              String   @id @default(cuid())
  status          String   @default("DRAFT")
  registryDigest  String
  grantDigest     String
  proposedTuples  Json     @default("[]") @db.JsonB
  approvedByUserId String?
  approvedAt      DateTime?
  appliedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, createdAt])
}

model AgentServiceWorkspace {
  id                   String   @id @default(cuid())
  agentType            String
  agentId              String
  applicationServiceId String
  recentAssetIds       String   @default("[]")
  pendingTasks         String   @default("[]")
  draftIds             String   @default("[]")
  generationHistory    String   @default("[]")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([agentType, agentId, applicationServiceId])
  @@index([applicationServiceId])
}

model AuditLog {
  id                   String   @id @default(cuid())
  actorType            String
  actorId              String
  channel              String
  action               String
  targetType           String
  targetId             String
  inputSummary         String
  outputSummary        String
  status               String
  errorMessage         String?
  applicationServiceId String?
  scopePath            String?
  createdAt            DateTime @default(now())

  @@index([actorType, actorId])
  @@index([channel, action])
  @@index([targetType, targetId])
  @@index([applicationServiceId, scopePath, createdAt])
  @@index([applicationServiceId, scopePath, targetType, targetId])
  @@index([createdAt])
}

model ConnectorInstance {
  dbId                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id                   String
  definitionId         String?
  kind                 String
  capabilities         Json     @default("[]") @db.JsonB
  configuration        Json     @default("{}") @db.JsonB
  status               String
  secretReference      String?
  applicationServiceId String
  scopePath            String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([applicationServiceId, scopePath, id], map: "ConnectorInstance_scope_id_key")
  @@index([applicationServiceId, scopePath, status], map: "ConnectorInstance_scope_status_idx")
}

model ConnectorDefinition {
  dbId                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id                   String
  kind                 String
  contractVersion      String
  capabilities         Json     @default("[]") @db.JsonB
  configurationSchema  Json     @default("{}") @db.JsonB
  status               String
  applicationServiceId String
  scopePath            String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([applicationServiceId, scopePath, id], map: "ConnectorDefinition_scope_id_key")
  @@index([applicationServiceId, scopePath, kind, status], map: "ConnectorDefinition_scope_kind_status_idx")
}

model FederationObservationCursor {
  dbId                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  connectorId          String
  sourceNamespace      String
  contractVersion      String
  acceptedSequence     Int      @default(-1)
  acceptedBatchDigest  String?
  sourceCursor         String?
  status               String
  lastObservedAt       DateTime?
  lastError            String?
  lastCompletedSnapshotId String?
  lastCompletedBoundaryDigest String?
  lastCompletedMappingVersion String?
  applicationServiceId String
  scopePath            String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([applicationServiceId, scopePath, connectorId, sourceNamespace], map: "FederationObservationCursor_scope_connector_namespace_key")
  @@index([applicationServiceId, scopePath, status], map: "FederationObservationCursor_scope_status_idx")
}

model FederationObservationBatch {
  dbId                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  connectorId          String
  sourceNamespace      String
  runId                String
  fencingToken         Int
  mode                 String
  snapshotId           String?
  mappingVersion       String
  mappingDigest        String
  inventoryBoundaryDigest String
  sequence             Int
  previousBatchDigest  String?
  batchDigest          String
  payloadDigest        String
  observationCount     Int
  canonicalBytes       Int
  pageIndex            Int
  isLastPage           Boolean
  sourceCursor         String?
  sourceHighWaterMark  String?
  observedAt           DateTime
  status               String
  acceptanceReceipt    Json     @default("{}") @db.JsonB
  applicationServiceId String
  scopePath            String
  acceptedAt           DateTime @default(now())
  createdAt            DateTime @default(now())

  @@unique([applicationServiceId, scopePath, connectorId, sourceNamespace, sequence], map: "FederationObservationBatch_scope_sequence_key")
  @@unique([applicationServiceId, scopePath, connectorId, sourceNamespace, batchDigest], map: "FederationObservationBatch_scope_digest_key")
  @@index([applicationServiceId, scopePath, connectorId, sourceNamespace, acceptedAt], map: "FederationObservationBatch_scope_connector_accepted_idx")
}

model SourceObservation {
  dbId                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id                   String
  connectorId          String
  sourceNamespace      String
  externalAssetType    String
  externalId           String
  operation            String   @default("UPSERT")
  payload              Json     @default("{}") @db.JsonB
  deletionReason       String?
  normalizedDigest     String
  sourceVersion        String
  runId                String?
  snapshotId           String?
  inventoryBoundaryDigest String?
  observedAt           DateTime
  status               String
  provenance           Json     @default("{}") @db.JsonB
  idempotencyKey       String
  applicationServiceId String
  scopePath            String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([applicationServiceId, scopePath, id], map: "SourceObservation_scope_id_key")
  @@unique([applicationServiceId, scopePath, idempotencyKey], map: "SourceObservation_scope_idempotency_key")
  @@unique([applicationServiceId, scopePath, connectorId, sourceNamespace, externalAssetType, externalId, sourceVersion], map: "SourceObservation_scope_external_identity_key")
  @@index([applicationServiceId, scopePath, connectorId, observedAt], map: "SourceObservation_scope_connector_observed_idx")
}

model ConnectorRun {
  dbId                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id                   String
  connectorId          String
  sourceNamespace      String
  mode                 String
  snapshotId           String?
  mappingVersion       String
  mappingDigest        String
  inventoryBoundaryDigest String
  status               String
  sourceCursor         String?
  sourceHighWaterMark  String?
  acceptedSequence     Int      @default(-1)
  acceptedBatchDigest  String?
  fencingToken         Int      @default(0)
  coverage             Json     @default("{}") @db.JsonB
  failureCode          String?
  failureMessage       String?
  queuedAt             DateTime @default(now())
  startedAt            DateTime?
  finishedAt           DateTime?
  applicationServiceId String
  scopePath            String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([applicationServiceId, scopePath, id], map: "ConnectorRun_scope_id_key")
  @@index([applicationServiceId, scopePath, connectorId, sourceNamespace, status], map: "ConnectorRun_scope_stream_status_idx")
  @@index([applicationServiceId, scopePath, queuedAt], map: "ConnectorRun_scope_queued_idx")
}

model ConnectorLease {
  dbId                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  connectorId          String
  sourceNamespace      String
  runId                String
  owner                String
  fencingToken         Int
  heartbeatAt          DateTime
  leaseExpiresAt       DateTime
  applicationServiceId String
  scopePath            String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([applicationServiceId, scopePath, connectorId, sourceNamespace], map: "ConnectorLease_scope_stream_key")
  @@index([applicationServiceId, scopePath, leaseExpiresAt], map: "ConnectorLease_scope_expiry_idx")
}

model ConnectorSnapshotIdentity {
  dbId                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId                String
  snapshotId           String
  externalAssetType    String
  externalId           String
  sourceVersion        String
  normalizedDigest     String
  observedAt           DateTime
  applicationServiceId String
  scopePath            String
  createdAt            DateTime @default(now())

  @@unique([applicationServiceId, scopePath, runId, externalAssetType, externalId], map: "ConnectorSnapshotIdentity_scope_run_identity_key")
  @@index([applicationServiceId, scopePath, snapshotId, externalAssetType, externalId], map: "ConnectorSnapshotIdentity_scope_snapshot_identity_idx")
}

model ConnectorDeadLetter {
  dbId                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id                   String
  runId                String
  connectorId          String
  sourceNamespace      String
  sequence             Int?
  pageIndex            Int?
  errorCode            String
  errorMessage         String
  payload              Json     @default("{}") @db.JsonB
  status               String
  attemptCount         Int      @default(0)
  lastAttemptAt        DateTime?
  replayedAt           DateTime?
  applicationServiceId String
  scopePath            String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([applicationServiceId, scopePath, id], map: "ConnectorDeadLetter_scope_id_key")
  @@index([applicationServiceId, scopePath, status, createdAt], map: "ConnectorDeadLetter_scope_status_idx")
}

model ConnectorHealthSnapshot {
  dbId                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id                   String
  connectorId          String
  sourceNamespace      String
  status               String
  metrics              Json     @default("{}") @db.JsonB
  capturedAt           DateTime
  applicationServiceId String
  scopePath            String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([applicationServiceId, scopePath, connectorId, sourceNamespace], map: "ConnectorHealthSnapshot_scope_stream_key")
  @@index([applicationServiceId, scopePath, status, capturedAt], map: "ConnectorHealthSnapshot_scope_status_idx")
}

model ExternalIdentityMapping {
  dbId                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id                   String
  connectorId          String
  sourceNamespace      String
  externalAssetType    String
  externalId           String
  assetType            String
  assetId              String?
  matchStatus          String
  normalizedDigest     String
  applicationServiceId String
  scopePath            String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([applicationServiceId, scopePath, id], map: "ExternalIdentityMapping_scope_id_key")
  @@unique([applicationServiceId, scopePath, connectorId, sourceNamespace, externalAssetType, externalId], map: "ExternalIdentityMapping_scope_external_identity_key")
  @@index([applicationServiceId, scopePath, assetType, assetId], map: "ExternalIdentityMapping_scope_asset_idx")
}

model AuthorityPolicy {
  dbId                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id                   String
  assetType            String
  fieldPath            String
  authority            String
  promotionMode        String
  policyVersion        String
  applicationServiceId String
  scopePath            String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([applicationServiceId, scopePath, id], map: "AuthorityPolicy_scope_id_key")
  @@unique([applicationServiceId, scopePath, assetType, fieldPath, policyVersion], map: "AuthorityPolicy_scope_field_version_key")
  @@index([applicationServiceId, scopePath, assetType, fieldPath], map: "AuthorityPolicy_scope_field_idx")
}

model DesignChangeSession {
  dbId                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id                   String
  actorId              String
  intent               String
  affectedFactIds      Json     @default("[]") @db.JsonB
  expectedEvidenceRefs Json     @default("[]") @db.JsonB
  preflightDigest      String?
  preflightRelationshipDigest String?
  preflightReadAssetIds Json    @default("[]") @db.JsonB
  closureReason        String?
  status               String
  openedAt             DateTime @default(now())
  applicationServiceId String
  scopePath            String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([applicationServiceId, scopePath, id], map: "DesignChangeSession_scope_id_key")
  @@index([applicationServiceId, scopePath, status, openedAt], map: "DesignChangeSession_scope_status_idx")
}

model ChangeAttestation {
  dbId                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attestationId        String
  issuer               String
  keyId                String
  algorithm            String
  payload              Json     @db.JsonB
  signature            String
  repositoryId         String
  parentCommit         String
  stagedTreeHash       String
  fileManifestDigest   String
  scopeMappingDigest   String
  actorId              String
  expiresAt            DateTime
  policyVersion        String
  applicationServiceId String
  scopePath            String
  createdAt            DateTime @default(now())

  @@unique([applicationServiceId, scopePath, attestationId], map: "ChangeAttestation_scope_id_key")
  @@index([applicationServiceId, scopePath, expiresAt], map: "ChangeAttestation_scope_expiry_idx")
  @@index([repositoryId, stagedTreeHash], map: "ChangeAttestation_repository_tree_idx")
}

model FederationOutbox {
  dbId                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventType             String
  payload               Json     @default("{}") @db.JsonB
  idempotencyKey        String
  status                String
  availableAt           DateTime @default(now())
  sentAt                DateTime?
  attemptCount          Int      @default(0)
  lastError             String?
  designChangeSessionId String?
  applicationServiceId  String
  scopePath             String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([applicationServiceId, scopePath, idempotencyKey], map: "FederationOutbox_scope_idempotency_key")
  @@index([applicationServiceId, scopePath, status, availableAt], map: "FederationOutbox_scope_pending_idx")
  @@index([applicationServiceId, scopePath, designChangeSessionId], map: "FederationOutbox_scope_session_idx")
}

model ReconciliationSnapshot {
  dbId                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  root                 String
  issues               Json     @default("[]") @db.JsonB
  status               String
  factDigests          Json     @default("[]") @db.JsonB
  applicationServiceId String
  scopePath            String
  createdAt            DateTime @default(now())

  @@unique([applicationServiceId, scopePath, root], map: "ReconciliationSnapshot_scope_root_key")
  @@index([applicationServiceId, scopePath, status, createdAt], map: "ReconciliationSnapshot_scope_status_idx")
}

model AssetNode {
  dbId                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  enterpriseId         String
  applicationServiceId String
  scopePath            String
  nodeType             String
  logicalId            String
  rootAssetType        String
  rootAssetId          String
  parentNodeId         String?  @db.Uuid
  nodePath             String
  displayName          String
  metadata             Json     @default("{}") @db.JsonB
  version              BigInt
  lifecycleStatus      String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  parent               AssetNode?           @relation("AssetNodeParent", fields: [enterpriseId, applicationServiceId, scopePath, parentNodeId], references: [enterpriseId, applicationServiceId, scopePath, dbId], map: "AssetNode_parent_scope_fkey")
  children             AssetNode[]           @relation("AssetNodeParent")
  sourceRelationships  RelationshipCurrent[] @relation("RelationshipSource")
  targetRelationships  RelationshipCurrent[] @relation("RelationshipTarget")
  impactResultNodes    ImpactResultNode[]    @relation("ImpactResultAssetNode")
  startingImpactPaths  ImpactResultPath[]    @relation("ImpactPathStartNode")
  endingImpactPaths    ImpactResultPath[]    @relation("ImpactPathEndNode")
  events               RelationshipEvent[]   @relation("RelationshipEventNode")

  @@unique([enterpriseId, applicationServiceId, scopePath, nodeType, logicalId], map: "AssetNode_scope_identity_key")
  @@unique([enterpriseId, applicationServiceId, scopePath, dbId], map: "AssetNode_enterprise_scope_dbId_key")
  @@index([enterpriseId, applicationServiceId, scopePath, rootAssetType, rootAssetId])
  @@index([enterpriseId, applicationServiceId, scopePath, parentNodeId])
}

model RelationshipCurrent {
  dbId                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  enterpriseId         String
  applicationServiceId String
  scopePath            String
  sourceNodeId         String   @db.Uuid
  targetNodeId         String   @db.Uuid
  relationType         String
  strength             String
  confidence           Float
  source               String
  sourceReference      String   @default("")
  validFrom            DateTime @default(now())
  validTo              DateTime?
  version              BigInt
  lifecycleStatus      String   @default("ACTIVE")
  metadata             Json     @default("{}") @db.JsonB
