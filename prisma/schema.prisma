generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model DesignAsset {
  dbId        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id          String
  type        String
  name        String
  code        String?
  description String
  domainId    String?
  applicationServiceId String
  scopePath   String
  payload     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
  @@index([domainId])
  @@index([applicationServiceId])
  @@index([scopePath])
  @@unique([applicationServiceId, scopePath, id])
}

model Proposal {
  dbId        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id          String
  title       String
  description String
  status      String
  domainId    String?
  applicationServiceId String
  scopePath   String
  payload     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([applicationServiceId])
  @@index([scopePath])
  @@unique([applicationServiceId, scopePath, id])
}

model ContextPack {
  dbId              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id                String
  name              String
  proposalId        String
  targetAgent       String
  summary           String
  includedAssets    String
  constraints       String
  instructions      String
  generatedMarkdown String
  payload           String?
  applicationServiceId String
  scopePath           String
  createdAt         DateTime @default(now())

  @@index([proposalId])
  @@index([applicationServiceId])
  @@index([scopePath])
  @@unique([applicationServiceId, scopePath, id])
}

model GovernanceCheckSnapshot {
  id         String   @id @default(cuid())
  assetType  String
  assetId    String
  results    String
  createdAt  DateTime @default(now())

  @@index([assetType, assetId])
}

model AssetLink {
  dbId         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id           String
  sourceType   String
  sourceId     String
  targetType   String
  targetId     String
  relationType String
  description  String?
  applicationServiceId String
  scopePath   String
  createdAt    DateTime @default(now())

  @@index([sourceType, sourceId])
  @@index([targetType, targetId])
  @@index([relationType])
  @@index([applicationServiceId])
  @@index([scopePath])
  @@unique([applicationServiceId, scopePath, id])
}

model ArchitectureScope {
  id          String   @id
  code        String   @unique
  name        String
  description String
  owner       String
  level       String
  parentId    String?
  scopePath   String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([parentId])
  @@index([level])
}

model ActorScopeGrant {
  id        String   @id @default(cuid())
  actorType String
  actorId   String
  scopeId   String
  action    String
  createdAt DateTime @default(now())

  @@unique([actorType, actorId, scopeId, action])
  @@index([actorType, actorId])
}

model AgentServiceWorkspace {
  id                   String   @id @default(cuid())
  agentType            String
  agentId              String
  applicationServiceId String
  recentAssetIds       String   @default("[]")
  pendingTasks         String   @default("[]")
  draftIds             String   @default("[]")
  generationHistory    String   @default("[]")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([agentType, agentId, applicationServiceId])
  @@index([applicationServiceId])
}

model AuditLog {
  id            String   @id @default(cuid())
  actorType     String
  actorId       String
  channel       String
  action        String
  targetType    String
  targetId      String
  inputSummary  String
  outputSummary String
  status        String
  errorMessage  String?
  createdAt     DateTime @default(now())

  @@index([actorType, actorId])
  @@index([channel, action])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model ConnectorInstance {
  dbId                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id                   String
  kind                 String
  capabilities         Json     @default("[]") @db.JsonB
  status               String
  secretReference      String?
  applicationServiceId String
  scopePath            String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([applicationServiceId, scopePath, id], map: "ConnectorInstance_scope_id_key")
  @@index([applicationServiceId, scopePath, status], map: "ConnectorInstance_scope_status_idx")
}

model SourceObservation {
  dbId                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id                   String
  connectorId          String
  sourceNamespace      String
  externalAssetType    String
  externalId           String
  payload              Json     @default("{}") @db.JsonB
  normalizedDigest     String
  sourceVersion        String
  observedAt           DateTime
  status               String
  provenance           Json     @default("{}") @db.JsonB
  idempotencyKey       String
  applicationServiceId String
  scopePath            String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([applicationServiceId, scopePath, id], map: "SourceObservation_scope_id_key")
  @@unique([applicationServiceId, scopePath, idempotencyKey], map: "SourceObservation_scope_idempotency_key")
  @@unique([applicationServiceId, scopePath, connectorId, sourceNamespace, externalAssetType, externalId, sourceVersion], map: "SourceObservation_scope_external_identity_key")
  @@index([applicationServiceId, scopePath, connectorId, observedAt], map: "SourceObservation_scope_connector_observed_idx")
}

model ExternalIdentityMapping {
  dbId                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id                   String
  connectorId          String
  sourceNamespace      String
  externalAssetType    String
  externalId           String
  assetType            String
  assetId              String?
  matchStatus          String
  normalizedDigest     String
  applicationServiceId String
  scopePath            String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([applicationServiceId, scopePath, id], map: "ExternalIdentityMapping_scope_id_key")
  @@unique([applicationServiceId, scopePath, connectorId, sourceNamespace, externalAssetType, externalId], map: "ExternalIdentityMapping_scope_external_identity_key")
  @@index([applicationServiceId, scopePath, assetType, assetId], map: "ExternalIdentityMapping_scope_asset_idx")
}

model AuthorityPolicy {
  dbId                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id                   String
  assetType            String
  fieldPath            String
  authority            String
  promotionMode        String
  policyVersion        String
  applicationServiceId String
  scopePath            String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([applicationServiceId, scopePath, id], map: "AuthorityPolicy_scope_id_key")
  @@unique([applicationServiceId, scopePath, assetType, fieldPath, policyVersion], map: "AuthorityPolicy_scope_field_version_key")
  @@index([applicationServiceId, scopePath, assetType, fieldPath], map: "AuthorityPolicy_scope_field_idx")
}

model DesignChangeSession {
  dbId                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id                   String
  actorId              String
  intent               String
  affectedFactIds      Json     @default("[]") @db.JsonB
  expectedEvidenceRefs Json     @default("[]") @db.JsonB
  preflightDigest      String?
  preflightRelationshipDigest String?
  preflightReadAssetIds Json    @default("[]") @db.JsonB
  closureReason        String?
  status               String
  openedAt             DateTime @default(now())
  applicationServiceId String
  scopePath            String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([applicationServiceId, scopePath, id], map: "DesignChangeSession_scope_id_key")
  @@index([applicationServiceId, scopePath, status, openedAt], map: "DesignChangeSession_scope_status_idx")
}

model FederationOutbox {
  dbId                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventType             String
  payload               Json     @default("{}") @db.JsonB
  idempotencyKey        String
  status                String
  availableAt           DateTime @default(now())
  sentAt                DateTime?
  attemptCount          Int      @default(0)
  lastError             String?
  designChangeSessionId String?
  applicationServiceId  String
  scopePath             String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([applicationServiceId, scopePath, idempotencyKey], map: "FederationOutbox_scope_idempotency_key")
  @@index([applicationServiceId, scopePath, status, availableAt], map: "FederationOutbox_scope_pending_idx")
  @@index([applicationServiceId, scopePath, designChangeSessionId], map: "FederationOutbox_scope_session_idx")
}

model ReconciliationSnapshot {
  dbId                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  root                 String
  issues               Json     @default("[]") @db.JsonB
  status               String
  factDigests          Json     @default("[]") @db.JsonB
  applicationServiceId String
  scopePath            String
  createdAt            DateTime @default(now())

  @@unique([applicationServiceId, scopePath, root], map: "ReconciliationSnapshot_scope_root_key")
  @@index([applicationServiceId, scopePath, status, createdAt], map: "ReconciliationSnapshot_scope_status_idx")
}

model AssetNode {
  dbId                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  enterpriseId         String
  applicationServiceId String
  scopePath            String
  nodeType             String
  logicalId            String
  rootAssetType        String
  rootAssetId          String
  parentNodeId         String?  @db.Uuid
  nodePath             String
  displayName          String
  metadata             Json     @default("{}") @db.JsonB
  version              BigInt
  lifecycleStatus      String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  parent               AssetNode?           @relation("AssetNodeParent", fields: [enterpriseId, applicationServiceId, scopePath, parentNodeId], references: [enterpriseId, applicationServiceId, scopePath, dbId], map: "AssetNode_parent_scope_fkey")
  children             AssetNode[]           @relation("AssetNodeParent")
  sourceRelationships  RelationshipCurrent[] @relation("RelationshipSource")
  targetRelationships  RelationshipCurrent[] @relation("RelationshipTarget")
  impactResultNodes    ImpactResultNode[]    @relation("ImpactResultAssetNode")
  startingImpactPaths  ImpactResultPath[]    @relation("ImpactPathStartNode")
  endingImpactPaths    ImpactResultPath[]    @relation("ImpactPathEndNode")
  events               RelationshipEvent[]   @relation("RelationshipEventNode")

  @@unique([enterpriseId, applicationServiceId, scopePath, nodeType, logicalId], map: "AssetNode_scope_identity_key")
  @@unique([enterpriseId, applicationServiceId, scopePath, dbId], map: "AssetNode_enterprise_scope_dbId_key")
  @@index([enterpriseId, applicationServiceId, scopePath, rootAssetType, rootAssetId])
  @@index([enterpriseId, applicationServiceId, scopePath, parentNodeId])
}

model RelationshipCurrent {
  dbId                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  enterpriseId         String
  applicationServiceId String
  scopePath            String
  sourceNodeId         String   @db.Uuid
  targetNodeId         String   @db.Uuid
  relationType         String
  strength             String
  confidence           Float
  source               String
  sourceReference      String   @default("")
  validFrom            DateTime @default(now())
  validTo              DateTime?
  version              BigInt
  lifecycleStatus      String   @default("ACTIVE")
  metadata             Json     @default("{}") @db.JsonB
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  sourceNode           AssetNode          @relation("RelationshipSource", fields: [enterpriseId, applicationServiceId, scopePath, sourceNodeId], references: [enterpriseId, applicationServiceId, scopePath, dbId], map: "RelationshipCurrent_source_scope_fkey")
  targetNode           AssetNode          @relation("RelationshipTarget", fields: [enterpriseId, applicationServiceId, scopePath, targetNodeId], references: [enterpriseId, applicationServiceId, scopePath, dbId], map: "RelationshipCurrent_target_scope_fkey")
  events               RelationshipEvent[] @relation("RelationshipEventCurrent")

  @@unique([enterpriseId, applicationServiceId, scopePath, sourceNodeId, targetNodeId, relationType, source, sourceReference], map: "RelationshipCurrent_enterprise_scope_identity_key")
  @@unique([enterpriseId, applicationServiceId, scopePath, dbId], map: "RelationshipCurrent_enterprise_scope_dbId_key")
  @@index([enterpriseId, applicationServiceId, scopePath, sourceNodeId, relationType], map: "RelationshipCurrent_scope_source_idx")
  @@index([enterpriseId, applicationServiceId, scopePath, targetNodeId, relationType], map: "RelationshipCurrent_scope_target_idx")
}

model RelationshipEvent {
  dbId                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  enterpriseId         String
  applicationServiceId String
  scopePath            String
  relationshipId       String?  @db.Uuid
  assetNodeId          String?  @db.Uuid
  action               String
  priorVersion         BigInt?
  newVersion           BigInt
  graphVersion         BigInt
  actorType            String
  actorId              String
  channel              String
  correlationId        String
  idempotencyKey       String
  source               String
  snapshot             Json     @default("{}") @db.JsonB
  createdAt            DateTime @default(now())

  relationship         RelationshipCurrent? @relation("RelationshipEventCurrent", fields: [enterpriseId, applicationServiceId, scopePath, relationshipId], references: [enterpriseId, applicationServiceId, scopePath, dbId], map: "RelationshipEvent_relationship_scope_fkey")
  assetNode            AssetNode?           @relation("RelationshipEventNode", fields: [enterpriseId, applicationServiceId, scopePath, assetNodeId], references: [enterpriseId, applicationServiceId, scopePath, dbId], map: "RelationshipEvent_asset_node_scope_fkey")
  outbox               RelationshipOutbox? @relation("RelationshipEventOutbox")
  projectionCheckpoints ProjectionCheckpoint[] @relation("ProjectionCheckpointLastEvent")

  @@unique([enterpriseId, applicationServiceId, scopePath, idempotencyKey], map: "RelationshipEvent_enterprise_scope_idempotency_key")
  @@unique([enterpriseId, applicationServiceId, scopePath, dbId], map: "RelationshipEvent_enterprise_scope_dbId_key")
  @@index([enterpriseId, applicationServiceId, scopePath, relationshipId, createdAt], map: "RelationshipEvent_scope_relationship_idx")
  @@index([enterpriseId, applicationServiceId, scopePath, assetNodeId, createdAt], map: "RelationshipEvent_scope_asset_node_idx")
}

model RelationshipCommandReceipt {
  dbId                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  enterpriseId         String
  applicationServiceId String
  scopePath            String
  idempotencyKey       String
  commandHash          String
  commandType          String
  status               String
  result               Json     @default("{}") @db.JsonB
  graphVersion         BigInt
  primaryEventId       String?  @db.Uuid
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([enterpriseId, applicationServiceId, scopePath, idempotencyKey], map: "RelationshipCommandReceipt_scope_idempotency_key")
  @@unique([enterpriseId, applicationServiceId, scopePath, dbId], map: "RelationshipCommandReceipt_scope_dbId_key")
  @@index([enterpriseId, applicationServiceId, scopePath, createdAt], map: "RelationshipCommandReceipt_scope_created_idx")
}

model RelationshipOutbox {
  dbId                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  enterpriseId         String
  applicationServiceId String
  scopePath            String
  relationshipEventId  String   @db.Uuid
  graphVersion         BigInt
  eventType            String
  payload              Json     @default("{}") @db.JsonB
  status               String
  idempotencyKey       String
  availableAt          DateTime @default(now())
  sentAt               DateTime?
  attemptCount         Int      @default(0)
  lastError            String?
  leaseOwner           String?
  leaseExpiresAt       DateTime?
  terminalAt           DateTime?
  diagnostic           String?
  diagnosticRef        String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  relationshipEvent    RelationshipEvent @relation("RelationshipEventOutbox", fields: [enterpriseId, applicationServiceId, scopePath, relationshipEventId], references: [enterpriseId, applicationServiceId, scopePath, dbId], map: "RelationshipOutbox_event_scope_fkey")

  @@unique([enterpriseId, applicationServiceId, scopePath, idempotencyKey], map: "RelationshipOutbox_enterprise_scope_idempotency_key")
  @@unique([enterpriseId, applicationServiceId, scopePath, relationshipEventId], map: "RelationshipOutbox_enterprise_scope_event_key")
  @@index([enterpriseId, applicationServiceId, scopePath, status, availableAt])
  @@index([status, availableAt, leaseExpiresAt, createdAt], map: "RelationshipOutbox_claim_order_idx")
  @@index([enterpriseId, applicationServiceId, scopePath, status, leaseExpiresAt], map: "RelationshipOutbox_scope_lease_recovery_idx")
}

model ProjectionCheckpoint {
  dbId                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  enterpriseId         String
  applicationServiceId String
  scopePath            String
  partitionId          String
  lastEventId          String?  @db.Uuid
  projectionVersion    BigInt
  projectedAt          DateTime?
  status               String
  error                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  lastEvent            RelationshipEvent? @relation("ProjectionCheckpointLastEvent", fields: [enterpriseId, applicationServiceId, scopePath, lastEventId], references: [enterpriseId, applicationServiceId, scopePath, dbId], map: "ProjectionCheckpoint_last_event_scope_fkey")

  @@unique([enterpriseId, applicationServiceId, scopePath, partitionId], map: "ProjectionCheckpoint_enterprise_scope_partition_key")
  @@index([enterpriseId, applicationServiceId, scopePath, projectionVersion])
}

model ImpactAnalysisRun {
  dbId                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  enterpriseId          String
  applicationServiceId  String
  scopePath             String
  proposalId            String
  status                String
  stopReason            String?
  assetVersion          BigInt
  relationshipVersion   BigInt
  ontologyVersion       String
  requiredGraphVersion  BigInt
  actualGraphCheckpoint BigInt?
  authorizationSnapshot Json     @default("{}") @db.JsonB
  budgets               Json     @default("{}") @db.JsonB
  summary               Json     @default("{}") @db.JsonB
  unexploredFrontierCount Int    @default(0)
  leaseOwner            String?
  leaseExpiresAt        DateTime?
  heartbeatAt           DateTime?
  startedAt             DateTime @default(now())
  completedAt           DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  resultNodes           ImpactResultNode[] @relation("ImpactRunNodes")

  @@unique([enterpriseId, applicationServiceId, scopePath, dbId], map: "ImpactAnalysisRun_enterprise_scope_dbId_key")
  @@index([enterpriseId, applicationServiceId, scopePath, status, createdAt], map: "ImpactAnalysisRun_scope_status_idx")
  @@index([enterpriseId, applicationServiceId, scopePath, status, leaseExpiresAt], map: "ImpactAnalysisRun_scope_lease_idx")
  @@index([enterpriseId, applicationServiceId, scopePath, proposalId], map: "ImpactAnalysisRun_scope_proposal_idx")
}

model ImpactResultNode {
  dbId                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  enterpriseId         String
  applicationServiceId String
  scopePath            String
  impactAnalysisRunId  String   @db.Uuid
  nodeId               String   @db.Uuid
  impactLevel          String
  certainty            String
  depth                Int
  confidence           Float
  primaryPath          Json     @default("{}") @db.JsonB
  alternativePaths     Json     @default("[]") @db.JsonB
  matchedRules         Json     @default("[]") @db.JsonB
  recommendedActions   Json     @default("[]") @db.JsonB
  owner                String?
  snapshot             Json     @default("{}") @db.JsonB
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  impactAnalysisRun    ImpactAnalysisRun @relation("ImpactRunNodes", fields: [enterpriseId, applicationServiceId, scopePath, impactAnalysisRunId], references: [enterpriseId, applicationServiceId, scopePath, dbId], map: "ImpactResultNode_run_scope_fkey")
  node                 AssetNode         @relation("ImpactResultAssetNode", fields: [enterpriseId, applicationServiceId, scopePath, nodeId], references: [enterpriseId, applicationServiceId, scopePath, dbId], map: "ImpactResultNode_node_scope_fkey")
  paths                ImpactResultPath[] @relation("ImpactResultNodePaths")

  @@unique([impactAnalysisRunId, nodeId], map: "ImpactResultNode_impactAnalysisRunId_nodeId_key")
  @@unique([enterpriseId, applicationServiceId, scopePath, dbId], map: "ImpactResultNode_enterprise_scope_dbId_key")
  @@index([enterpriseId, applicationServiceId, scopePath, impactAnalysisRunId])
}

model ImpactResultPath {
  dbId                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  enterpriseId         String
  applicationServiceId String
  scopePath            String
  impactResultNodeId   String   @db.Uuid
  startNodeId          String   @db.Uuid
  endNodeId            String   @db.Uuid
  rank                 Int
  certainty            String
  confidence           Float
  path                 Json     @default("{}") @db.JsonB
  createdAt            DateTime @default(now())

  impactResultNode     ImpactResultNode @relation("ImpactResultNodePaths", fields: [enterpriseId, applicationServiceId, scopePath, impactResultNodeId], references: [enterpriseId, applicationServiceId, scopePath, dbId], map: "ImpactResultPath_result_scope_fkey")
  startNode            AssetNode        @relation("ImpactPathStartNode", fields: [enterpriseId, applicationServiceId, scopePath, startNodeId], references: [enterpriseId, applicationServiceId, scopePath, dbId], map: "ImpactResultPath_start_scope_fkey")
  endNode              AssetNode        @relation("ImpactPathEndNode", fields: [enterpriseId, applicationServiceId, scopePath, endNodeId], references: [enterpriseId, applicationServiceId, scopePath, dbId], map: "ImpactResultPath_end_scope_fkey")

  @@unique([impactResultNodeId, rank], map: "ImpactResultPath_impactResultNodeId_rank_key")
  @@index([enterpriseId, applicationServiceId, scopePath, impactResultNodeId])
}
